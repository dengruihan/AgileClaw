--- a/web/calendar.ts
+++ b/web/calendar.ts
@@ -156,3 +156,69 @@ export function safeSourceUrl(url: string | null): string | null {
     return null;
   }
 }
+
+const STALE_CHECK_DAYS = 7;
+export type ItemType = "course" | "meeting" | "todo";
+export type SidebarGroups = {
+  overdue: AgendaItem[];
+  unscheduled: AgendaItem[];
+  undated: AgendaItem[];
+  scheduled: AgendaItem[];
+  history: AgendaItem[];
+  waiting: AgendaItem[];
+  completed: AgendaItem[];
+};
+
+export function isSourceOwned(item: AgendaItem, sources: AgendaSource[]): boolean {
+  return sources.some((source) => source.id === item.sourceId && source.managedBy === "source");
+}
+
+export function itemType(item: AgendaItem, sources: AgendaSource[]): ItemType {
+  if (item.kind === "task") return "todo";
+  return isSourceOwned(item, sources) ? "course" : "meeting";
+}
+
+export function sourceStaleLabel(source: AgendaSource, today = beijingDate()): string | null {
+  if (source.status === "error") return "读取失败";
+  if (source.status === "waiting") return "等待读取";
+  if (source.status === "unknown") return "尚未读取";
+  if (!source.coverageEnd) return "尚无覆盖范围";
+  if (source.coverageEnd < today) return "覆盖已过期";
+  if (!source.checkedAt) return "没有读取时间";
+  const checked = beijingDate(source.checkedAt);
+  const age = Math.floor(
+    (Date.parse(`${today}T00:00:00Z`) - Date.parse(`${checked}T00:00:00Z`)) / DAY,
+  );
+  return age > STALE_CHECK_DAYS ? `已 ${age} 天未更新` : null;
+}
+
+export function itemGroups(items: AgendaItem[], blocks: AgendaBlock[], now: number): SidebarGroups {
+  const placed = new Set(blocks.map((block) => block.itemId));
+  const future = new Set(
+    blocks.filter((block) => Date.parse(block.end) > now).map((block) => block.itemId),
+  );
+  const active = items.filter((item) => item.status !== "done" && item.status !== "cancelled");
+  const overdue = active.filter((item) => itemOverdue(item, now));
+  const scheduled = active.filter(
+    (item) => future.has(item.id) && !itemOverdue(item, now) && item.status !== "waiting",
+  );
+  return {
+    overdue,
+    unscheduled: active.filter(
+      (item) =>
+        !placed.has(item.id) &&
+        (item.dueAt || item.dueDate) &&
+        item.status !== "waiting",
+    ),
+    // Ended courses keep their history instead of becoming undated todos.
+    undated: active.filter(
+      (item) => !placed.has(item.id) && !item.dueAt && !item.dueDate && item.status !== "waiting",
+    ),
+    scheduled,
+    history: active.filter(
+      (item) => placed.has(item.id) && !future.has(item.id) && item.status !== "waiting",
+    ),
+    waiting: items.filter((item) => item.status === "waiting"),
+    completed: items.filter((item) => item.status === "done" || item.status === "cancelled"),
+  };
+}
