+const dayItem = (id: string, overrides: Partial<AgendaItem> = {}): AgendaItem => ({
+  ...itemShape,
+  id,
+  title: id,
+  sourceId: "local",
+  sourceKey: null,
+  ...overrides,
+});
+
+describe("Agenda unified desktop day table", () => {
+  it("returns morning and afternoon blocks together with all-day entries and deadlines", () => {
+    const morning = dayItem("morning", { kind: "event", title: "数学" });
+    const afternoon = dayItem("afternoon", { kind: "event", title: "英语" });
+    const allDay = dayItem("all-day", { kind: "event", title: "开放日" });
+    const deadline = dayItem("deadline", {
+      title: "交报告",
+      dueAt: "2026-11-03T21:00:00+08:00",
+    });
+    const tomorrow = dayItem("tomorrow", { title: "明天截止", dueAt: "2026-11-04T09:00:00+08:00" });
+    const unscheduled = dayItem("unscheduled", { title: "写周报" });
+    const blocks = [
+      { ...block("morning", "2026-11-03T08:10:00+08:00", "2026-11-03T08:50:00+08:00"), itemId: "morning" },
+      { ...block("afternoon", "2026-11-03T14:00:00+08:00", "2026-11-03T14:40:00+08:00"), itemId: "afternoon" },
+      {
+        id: "all-day-block",
+        itemId: "all-day",
+        start: "2026-11-03T00:00:00+08:00",
+        end: "2026-11-04T00:00:00+08:00",
+        allDay: true,
+        locked: false,
+        reason: "",
+      },
+    ];
+    const schedule = daySchedule(
+      blocks,
+      [afternoon, unscheduled, tomorrow, morning, allDay, deadline],
+      "2026-11-03",
+    );
+    expect(schedule.segments.map(({ item, startMinute, endMinute }) => [item.id, startMinute, endMinute])).toEqual([
+      ["morning", 490, 530],
+      ["afternoon", 840, 880],
+    ]);
+    expect(schedule.allDayBlocks.map(({ itemId }) => itemId)).toEqual(["all-day"]);
+    expect(schedule.deadlines.map(({ id }) => id)).toEqual(["deadline"]);
+  });
+
+  it("keeps overnight segments in the table on both days without inventing items", () => {
+    const overnight = dayItem("overnight", { kind: "event", title: "夜间维护" });
+    const midnightBlock = {
+      ...block("overnight", "2026-11-03T23:30:00+08:00", "2026-11-04T00:30:00+08:00"),
+      itemId: "overnight",
+    };
+    const firstDay = daySchedule([midnightBlock], [overnight], "2026-11-03");
+    const secondDay = daySchedule([midnightBlock], [overnight], "2026-11-04");
+    expect(firstDay.segments.map(({ startMinute, endMinute }) => [startMinute, endMinute])).toEqual([
+      [1410, 1440],
+    ]);
+    expect(secondDay.segments.map(({ startMinute, endMinute }) => [startMinute, endMinute])).toEqual([
+      [0, 30],
+    ]);
+    expect(daySchedule([midnightBlock], [], "2026-11-03").segments).toEqual([]);
+  });
+
+  it("resolves date-only and timed deadlines in Beijing time", () => {
+    expect(dueDate(dayItem("date-only", { dueDate: "2026-11-03" }))).toBe("2026-11-03");
+    expect(dueDate(dayItem("timed", { dueAt: "2026-11-03T16:30:00Z" }))).toBe("2026-11-04");
+    expect(dueDate(dayItem("undated"))).toBeNull();
+  });
+});
diff --git a/web/calendar.ts b/web/calendar.ts
index 5424148..c90d8af 100644
--- a/web/calendar.ts
+++ b/web/calendar.ts
@@ -145,6 +145,34 @@ export function blocksOnDay(blocks: AgendaBlock[], date: string): AgendaBlock[]
       Date.parse(block.end) > dayStart(date),
   );
 }
+export function dueDate(item: AgendaItem): string | null {
+  return item.dueDate ?? (item.dueAt ? beijingDate(item.dueAt) : null);
+}
+export type DaySchedule = {
+  allDayBlocks: AgendaBlock[];
+  deadlines: AgendaItem[];
+  segments: (BlockSegment & { item: AgendaItem })[];
+};
+// The desktop day table reads the whole Beijing day in one pass: every timed
+// block, all-day entry, and deadline belongs to the same table.
+export function daySchedule(
+  blocks: AgendaBlock[],
+  items: AgendaItem[],
+  date: string,
+): DaySchedule {
+  const byId = new Map(items.map((item) => [item.id, item]));
+  return {
+    allDayBlocks: blocksOnDay(
+      blocks.filter((block) => block.allDay),
+      date,
+    ),
+    deadlines: items.filter((item) => dueDate(item) === date),
+    segments: daySegments(blocks, date).flatMap((segment) => {
+      const item = byId.get(segment.block.itemId);
+      return item ? [{ ...segment, item }] : [];
+    }),
+  };
+}
 export function safeSourceUrl(url: string | null): string | null {
   if (!url) {
     return null;
